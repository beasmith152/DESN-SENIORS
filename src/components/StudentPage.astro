---
const { name, image, favorite_emoji, github_permalink, github_profile, codepen_profile, bio } = Astro.props;
---

<main class="student-page">
  <img src={image} alt={name} />
  <h1><span class="emoji">{favorite_emoji}</span> {name}</h1>
  <p class="bio">{bio}</p>

  <nav class="links">
    <a href={github_permalink} target="_blank" rel="noopener">Portfolio</a>
    <a href={github_profile} target="_blank" rel="noopener">GitHub</a>
    <a href={codepen_profile} target="_blank" rel="noopener">CodePen</a>
  </nav>

  <button class="back" onclick="window.location.href = '/'">Back to Home</button>
</main>

<style>
  .student-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    padding: 2rem 1rem;
    color: azure;
  }

  .student-page img {
    width: 320px;
    max-width: 80%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  .student-page h1 {
    font-family: "Commissioner", sans-serif;
    font-weight: 200;
    font-size: 1.6rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .student-page .bio {
    font-family: "Commissioner", sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    max-width: 60ch;
    text-align: center;
    color: #dfeff0;
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .links a {
    text-decoration: none;
    color: goldenrod;
    font-family: "Commissioner", sans-serif;
    font-weight: 400;
  }

  .links a:hover {
    color: #fff;
    font-size: 1.1rem;
  }

  .back {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background: transparent;
    color: azure;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    cursor: pointer;
    font-family: "Commissioner", sans-serif;
  }

  .back:hover {
    background: rgba(255,255,255,0.04);
  }
</style>